# Base URL that the Kindle can reach. Prefer a private, stable LAN address.
KINDLETOKEN_PUBLIC_URL=http://192.168.0.135:8787

# Required by POST /api/v1/ingest. Generate: openssl rand -hex 32

# Six hours. Align the Kindle RTC wake after the collector window.
KINDLETOKEN_REFRESH_SECONDS=1800

# Logical dashboard canvas.
KINDLETOKEN_DISPLAY_WIDTH=1448
KINDLETOKEN_DISPLAY_HEIGHT=1072

# Native Kindle framebuffer output. The defaults match the verified KT3 setup.
KINDLETOKEN_FRAMEBUFFER_WIDTH=1072
KINDLETOKEN_FRAMEBUFFER_HEIGHT=1448
KINDLETOKEN_FRAMEBUFFER_ROTATION=270

# Collector health threshold used by the authenticated status endpoint.
KINDLETOKEN_STALE_HOURS=8

# Leave blank to use ./data. On a server, set a durable absolute location.
KINDLETOKEN_DATA_DIR=

KINDLETOKEN_SERVER=http://127.0.0.1:8787
KINDLETOKEN_MACHINE_ID=pc
KINDLETOKEN_AGENTS=claude-code
KINDLETOKEN_CCUSAGE_COMMAND=C:/Users/sriva/AppData/Roaming/npm/node_modules/bun/bin/bunx.exe ccusage@latest daily --by-agent --json
KINDLETOKEN_INGEST_TOKEN=replace-me
