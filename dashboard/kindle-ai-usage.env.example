# Public URL of this server, as seen by the Kindle (Tailscale Funnel or a LAN address).
KINDLETOKEN_PUBLIC_URL=https://YOUR-PC.YOUR-TAILNET.ts.net

# Filled in by setup-kindle-ai-usage.ps1.
KINDLETOKEN_INGEST_TOKEN=replace-me

# Thirty minutes, matching REFRESH_SECONDS in kindle/kindletoken.conf.
KINDLETOKEN_REFRESH_SECONDS=1800

# Landscape canvas and native framebuffer. These are Kindle Paperwhite 3 values;
# measure your own Kindle with kindle/scriptlets/fbtest.sh.
KINDLETOKEN_DISPLAY_WIDTH=1448
KINDLETOKEN_DISPLAY_HEIGHT=1072
KINDLETOKEN_FRAMEBUFFER_WIDTH=1072
KINDLETOKEN_FRAMEBUFFER_HEIGHT=1448
KINDLETOKEN_FRAMEBUFFER_ROTATION=270

KINDLETOKEN_STALE_HOURS=8
KINDLETOKEN_DATA_DIR=

# Collector: pushes local ccusage totals to the server on this machine.
KINDLETOKEN_SERVER=http://127.0.0.1:8787
KINDLETOKEN_MACHINE_ID=pc
# Comma-separated agents to keep, e.g. claude-code,codex. Remove the line to keep all.
KINDLETOKEN_AGENTS=claude-code
# Filled in by setup-kindle-ai-usage.ps1 with the full path to bunx.exe.
KINDLETOKEN_CCUSAGE_COMMAND=BUNX ccusage@latest daily --by-agent --json
